{
  "name": "bugsink-mcp",
  "version": "0.3.0",
  "description": "MCP server for Bugsink — read and write",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "bugsink-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.23.8"
  },
  "license": "MIT",
  "author": "Alfredo Costa",
  "keywords": [
    "mcp",
    "bugsink",
    "error-tracking",
    "model-context-protocol",
    "sentry-alternative"
  ],
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
